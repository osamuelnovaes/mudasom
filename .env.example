# Required to lock the private, personal-use app.
APP_PASSWORD=change-this-to-a-long-private-password
APP_SESSION_SECRET=generate-a-random-secret-at-least-32-characters-long

# Spotify Developer Dashboard credentials.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3000/api/auth/spotify/callback

# Google Cloud OAuth client with YouTube Data API v3 enabled.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/youtube/callback
